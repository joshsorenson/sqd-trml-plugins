{%- comment -%}
  Runs before every size. Holds the logo, shared limits and partials.
  Data comes from /api/linear-issues (see README for the response shape).
{%- endcomment -%}

{%- capture linear_logo -%}
<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 100 100" fill="none"><path fill="#000" d="M1.22541 61.5228c-.2225-.9485.90748-1.5459 1.59638-.857L39.3342 97.1782c.6889.6889.0915 1.8189-.857 1.5964C20.0515 94.4522 5.54779 79.9485 1.22541 61.5228ZM.00189135 46.8891c-.01764375.2833.08887215.5599.28957165.7606L52.3503 99.7085c.2007.2007.4773.3075.7606.2896 2.3692-.1476 4.6938-.46 6.9624-.9259.7645-.157 1.0301-1.0963.4782-1.6481L2.57595 39.4485c-.55186-.5519-1.49117-.2863-1.648174.4782-.465915 2.2686-.77832 4.5932-.92588465 6.9624ZM4.21093 29.7054c-.16649.3738-.08169.8106.20765 1.1l64.77602 64.776c.2894.2894.7262.3742 1.1.2077 1.7861-.7956 3.5171-1.6927 5.1855-2.684.5521-.328.6373-1.0867.1832-1.5407L8.43566 24.3367c-.45409-.4541-1.21271-.3689-1.54074.1832-.99132 1.6684-1.88843 3.3994-2.68399 5.1855ZM12.6587 18.074c-.3701-.3701-.393-.9637-.0443-1.3541C21.7795 6.45931 35.1114 0 49.9519 0 77.5927 0 100 22.4073 100 50.0481c0 14.8405-6.4593 28.1724-16.7199 37.3375-.3903.3487-.984.3258-1.3542-.0443L12.6587 18.074Z"/></svg>
{%- endcapture -%}

{%- assign max_issues = trmnl.plugin_settings.custom_fields_values.max_issues | default: 11 | plus: 0 -%}
{%- assign issue_count = total_count | default: 0 -%}

{%- comment -%}
  Color or mono. Color panels (B/W/R/Y, Spectra, etc.) get accents. On mono
  screens the framework turns color into dot patterns, which makes text hard
  to read, so mono keeps the black-and-white styling. The optional color_mode
  setting (auto / color / mono) overrides the device check.
{%- endcomment -%}
{%- assign color_mode = trmnl.plugin_settings.custom_fields_values.color_mode | default: "auto" | downcase -%}
{%- assign device_model = trmnl.device.model | default: "" | downcase -%}
{%- assign use_color = false -%}
{%- if color_mode == "color" -%}
  {%- assign use_color = true -%}
{%- elsif color_mode == "auto" -%}
  {%- if device_model contains "bwr" or device_model contains "color" or device_model contains "spectra" or device_model contains "impression" or device_model == "seeed_e1002" -%}
    {%- assign use_color = true -%}
  {%- endif -%}
{%- endif -%}


{%- capture instance_label -%}
  {{ issue_count }} open{% if current_cycle %} · Cycle {{ current_cycle }}{% endif %}
{%- endcapture -%}

{% template title_bar %}
<div class="title_bar">
  <img class="image image-stroke" src="data:image/svg+xml;base64,{{ logo | base64_encode }}" />
  <span class="title">{{ trmnl.plugin_settings.instance_name | default: "Linear" }}</span>
  <span class="instance">{{ instance }}</span>
</div>
{% endtemplate %}

{% template empty_state %}
<div class="layout layout--col layout--center gap">
  {% if error %}
    <span class="title">Can't reach Linear</span>
    <span class="description text--center" data-clamp="2">{{ details | default: error }}</span>
  {% else %}
    <span class="title">All clear</span>
    <span class="description">No open issues in this cycle or earlier</span>
  {% endif %}
</div>
{% endtemplate %}

{%- comment -%}
  Only Urgent and High get a badge. Mono: filled black / outlined.
  Color: red / yellow. Gray text breaks up on 1-bit screens, so none here.
{%- endcomment -%}
{% template priority_label %}
{%- if priority == 1 -%}
  <span class="label label--small {% if use_color %}label--error{% else %}label--filled{% endif %}">Urgent</span>
{%- elsif priority == 2 -%}
  <span class="label label--small {% if use_color %}label--warning{% else %}label--outline{% endif %}">High</span>
{%- endif -%}
{% endtemplate %}

{%- comment -%} Carried-over issues get called out; current-cycle ones stay quiet. {%- endcomment -%}
{% template cycle_label %}
{%- if cycle_status == "past" -%}
  <span class="label label--small label--underline{% if use_color %} text--red{% endif %}">C{{ cycle_number }} late</span>
{%- else -%}
  <span class="label label--small">C{{ cycle_number }}</span>
{%- endif -%}
{% endtemplate %}
